{
  "account": {
    "description": "萌宅账号（用户名/邮箱）",
    "type": "string",
    "default": "",
    "hint": "登录用的 account 字段"
  },
  "password": {
    "description": "萌宅密码",
    "type": "string",
    "default": "",
    "secret": true
  },
  "sign_secret": {
    "description": "签名密钥 signSecret",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "必填，自行填写"
  },
  "app_pkg": {
    "description": "X-App-Pkg",
    "type": "string",
    "default": "",
    "hint": "必填，自行填写"
  },
  "app_ver": {
    "description": "X-App-Ver",
    "type": "string",
    "default": "",
    "hint": "必填，自行填写"
  },
  "api_base": {
    "description": "API 地址",
    "type": "string",
    "default": "",
    "hint": "例如 https://cn-api.mengzhai.club"
  },
  "enable_on_start": {
    "description": "启动时自动开启监听",
    "type": "bool",
    "default": true
  },
  "poll_interval": {
    "description": "轮询间隔（秒）",
    "type": "int",
    "default": 300,
    "hint": "建议 180~600"
  },
  "push_targets": {
    "description": "推送目标会话",
    "type": "list",
    "default": [],
    "_special": "umo",
    "hint": "在 WebUI 选择群或私聊"
  },
  "max_new_per_push": {
    "description": "单次最多推送新卡数量",
    "type": "int",
    "default": 5
  },
  "categories": {
    "description": "只推送这些分类（留空=全部）",
    "type": "list",
    "default": [],
    "hint": "助手 / 恋爱 / 二次元 / 搞笑 / 故事 / 学习 / 游戏 / 其他"
  },
  "min_imports": {
    "description": "最低导入数过滤（0=不限制）",
    "type": "int",
    "default": 0
  },
  "keyword_include": {
    "description": "名称/简介需包含关键词（留空=不限）",
    "type": "list",
    "default": [],
    "hint": "任一命中即保留"
  },
  "keyword_exclude": {
    "description": "名称/简介排除关键词（留空=不排除）",
    "type": "list",
    "default": [],
    "hint": "任一命中即丢弃"
  },
  "push_image": {
    "description": "推送角色图片",
    "type": "bool",
    "default": true
  },
  "prefer_avatar": {
    "description": "优先使用头像（否则优先背景图）",
    "type": "bool",
    "default": true
  },
  "use_markdown": {
    "description": "使用 Markdown 文案（官方机器人推荐开启）",
    "type": "bool",
    "default": true
  },
  "message_template": {
    "description": "推送文案模板（支持 Markdown）",
    "type": "text",
    "default": "## 🆕 萌宅新角色卡\n\n**{name}**\n\n- 作者：{author}\n- 分类：{category}\n- 导入：{imports}\n- 评分：{rating}\n\n> {summary}\n\n***\nID：`{id}`"
  },
  "plain_message_template": {
    "description": "纯文本兜底模板（Markdown 失败时使用）",
    "type": "text",
    "default": "🆕 萌宅新角色卡\n名称：{name}\n作者：{author}\n分类：{category}\n导入：{imports}\n评分：{rating}\n简介：{summary}\nID：{id}"
  },
  "request_retry_times": {
    "description": "请求失败重试次数",
    "type": "int",
    "default": 3
  },
  "request_retry_delay": {
    "description": "请求重试基础间隔（秒）",
    "type": "int",
    "default": 2
  },
  "push_retry_times": {
    "description": "推送失败重试次数",
    "type": "int",
    "default": 2
  },
  "sort": {
    "description": "市场排序",
    "type": "string",
    "default": "newest",
    "hint": "newest / hot / popular"
  },
  "init_seen_on_start": {
    "description": "启动时把当前市场卡片记入已读（避免刷屏）",
    "type": "bool",
    "default": true
  }
}